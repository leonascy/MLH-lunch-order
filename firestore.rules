rules_version = '2';

// Only the one family account can read or write anything.
// Replace PASTE_FAMILY_UID with the User UID from Firebase console → Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == "PASTE_FAMILY_UID";
    }
  }
}
